{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mali-tintash/hgate/docs/hgate-project.schema.json",
  "title": "hGATE project projection",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "domains",
    "boundedContexts",
    "relationships",
    "journeys"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domain" }
    },
    "boundedContexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundedContext" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "journeys": {
      "type": "array",
      "items": { "$ref": "#/$defs/journey" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "domain": {
      "type": "object",
      "required": ["id", "name", "classification", "purpose"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": ["CORE", "SUPPORTING", "GENERIC", "UNCONFIRMED"]
        },
        "purpose": { "type": "string" }
      }
    },
    "capability": {
      "type": "object",
      "required": ["name", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string" },
        "outcome": { "type": "string" },
        "status": { "enum": ["CONFIRMED", "PROVISIONAL"] }
      }
    },
    "port": {
      "type": "object",
      "required": ["name", "direction", "purpose", "contract"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": {
          "enum": ["INBOUND", "OUTBOUND", "BIDIRECTIONAL", "UNKNOWN"]
        },
        "purpose": { "type": "string" },
        "contract": { "type": "string" }
      }
    },
    "acl": {
      "type": "object",
      "required": ["name", "system", "direction", "file"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "system": { "type": "string" },
        "direction": {
          "enum": ["INBOUND", "OUTBOUND", "BIDIRECTIONAL", "UNKNOWN"]
        },
        "purpose": { "type": "string" },
        "file": { "type": "string" }
      }
    },
    "lifecycleState": {
      "enum": [
        "DISCOVERED",
        "REFINING",
        "REFINED",
        "SPEC_REVIEWED",
        "IMPLEMENTING",
        "IMPLEMENTED",
        "VERIFIED",
        "CHANGING",
        "BLOCKED",
        "DEPRECATED"
      ]
    },
    "transition": {
      "type": "object",
      "required": ["date", "from", "to", "evidence", "actor"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "evidence": { "type": "string" },
        "actor": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["transition", "gate", "kind", "result", "evidence", "signedBy", "date"],
      "additionalProperties": false,
      "properties": {
        "transition": {
          "type": "string",
          "pattern": "^(-|DISCOVERED|REFINING|REFINED|SPEC_REVIEWED|IMPLEMENTING|IMPLEMENTED|VERIFIED|CHANGING|BLOCKED|DEPRECATED) -> (DISCOVERED|REFINING|REFINED|SPEC_REVIEWED|IMPLEMENTING|IMPLEMENTED|VERIFIED|CHANGING|BLOCKED|DEPRECATED)$"
        },
        "gate": { "type": "string", "pattern": "^GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "kind": { "enum": ["H", "D", "R"] },
        "result": { "enum": ["PASS", "FAIL", "WAIVED", "N/A"] },
        "evidence": { "type": "string", "minLength": 1 },
        "signedBy": { "type": ["string", "null"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "openItem": {
      "type": "object",
      "required": ["id", "item", "owner", "disposition"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["string", "null"] },
        "item": { "type": "string" },
        "owner": { "type": "string" },
        "disposition": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "rules",
        "features",
        "scenarios",
        "decisions",
        "properties",
        "acls",
        "ports",
        "openItems",
        "openGaps"
      ],
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "number" },
        "features": { "type": "number" },
        "scenarios": { "type": "number" },
        "decisions": { "type": "number" },
        "properties": { "type": "number" },
        "acls": { "type": "number" },
        "ports": { "type": "number" },
        "openItems": { "type": "number" },
        "openGaps": { "type": "number" }
      }
    },
    "signoff": {
      "type": "object",
      "required": ["kind", "file", "date"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["bdd", "business", "review"] },
        "file": { "type": "string", "minLength": 1 },
        "date": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "outcome": { "type": "string" }
      }
    },
    "boundedContext": {
      "type": "object",
      "required": [
        "id",
        "name",
        "domainId",
        "classification",
        "role",
        "lifecycle",
        "owns",
        "doesNotOwn",
        "capabilities",
        "ports",
        "acls",
        "nextSkill",
        "blockers",
        "transitions",
        "gates",
        "openItems",
        "stats",
        "signoffs",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "domainId": { "$ref": "#/$defs/id" },
        "classification": {
          "enum": ["CORE", "SUPPORTING", "GENERIC", "UNCONFIRMED"]
        },
        "role": {
          "enum": ["PRIMARY", "SHARED", "SUPPORTING", "UNCONFIRMED"]
        },
        "lifecycle": { "$ref": "#/$defs/lifecycleState" },
        "purpose": { "type": "string" },
        "owns": { "type": "array", "items": { "type": "string" } },
        "doesNotOwn": { "type": "array", "items": { "type": "string" } },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" }
        },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "acls": {
          "type": "array",
          "items": { "$ref": "#/$defs/acl" }
        },
        "nextSkill": { "type": ["string", "null"] },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        },
        "openItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/openItem" }
        },
        "stats": { "$ref": "#/$defs/stats" },
        "signoffs": {
          "type": "array",
          "items": { "$ref": "#/$defs/signoff" }
        },
        "sources": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["id", "from", "to", "information", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "information": { "type": "string" },
        "sourceOfTruth": { "type": "string" },
        "consistency": { "type": "string" },
        "interaction": { "type": "string" },
        "translationAcl": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "journey": {
      "type": "object",
      "required": ["id", "name", "boundedContextIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "boundedContextIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "entryPoint": { "type": "string" },
        "outcome": { "type": "string" },
        "validationArtifact": { "type": "string" }
      }
    },
    "gapSource": {
      "type": "object",
      "required": ["file", "line", "bc", "owner", "disposition"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "number" },
        "bc": { "type": ["string", "null"] },
        "owner": { "type": "string" },
        "disposition": { "type": "string" }
      }
    },
    "gap": {
      "type": "object",
      "required": ["id", "gap", "affected", "state", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "gap": { "type": "string" },
        "affected": { "type": ["string", "null"] },
        "state": { "enum": ["RESOLVED", "DEFERRED", "OPEN", "MIXED"] },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/gapSource" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message", "file", "line", "bcId", "gapId"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^HGW\\d{3}$" },
        "severity": { "const": "warning" },
        "message": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "number" },
        "bcId": { "type": ["string", "null"] },
        "gapId": { "type": ["string", "null"] }
      }
    }
  }
}
