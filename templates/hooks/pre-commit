#!/usr/bin/env sh
# hGATE pre-commit hook example. Install manually:
#   cp templates/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# or call it from your Husky .husky/pre-commit file. hGATE never installs it.
#
# Checks the generated project projection and runs the deterministic
# traceability verifiers only when a staged change can
# affect them (tests, scenario or property specs, or the tooling itself).
#
# verify-spec includes the lifecycle gate checks (HGS*) and gap drift warnings
# (HGW001/HGW002). Warnings are printed but never block the commit; only
# errors do. project:status is never run here: .hgate/status.json is derived,
# gitignored output (run `npm run project:status` on demand or in CI).

set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
if printf '%s\n' "$staged" | grep -Eq '(domain-map\.md$|context-map\.md$|/(SKILL|status|domain-model|bdd-scenarios)\.md$|-acl\.md$|hgate-project\.json$)'; then
  echo "hGATE: checking docs/hgate-project.json projection..."
  npm run --silent project:check
fi

# Specification consistency, lifecycle gates and gap drift: BC skill files,
# status.md, the domain/context maps, event files or the tooling.
if [ -f tools/verify-spec/verify.mjs ] &&
  printf '%s\n' "$staged" | grep -Eq '(\.github/skills/.*\.md$|domain-map\.md$|context-map\.md$|\.event\.ts$|^tools/)'; then
  echo "hGATE: verifying specification consistency and lifecycle gates..."
  npm run --silent verify:spec
fi

if ! printf '%s\n' "$staged" | grep -Eq '(\.(spec|test)\.ts$|bdd-scenarios\.md$|properties\.md$|\.github/skills/.*\.md$|\.event\.ts$|^tools/)'; then
  exit 0
fi

echo "hGATE: verifying BDD traceability..."
npm run --silent verify:bdd

if ls .github/skills/*/properties.md >/dev/null 2>&1; then
  echo "hGATE: verifying business-property traceability..."
  npm run --silent verify:properties
fi
